# Copy to .env (next to docker-compose.yml) and fill in. Leave both empty to
# use the scanner without Paperless; PDFs can still be downloaded.

# Your Paperless-ngx address, as this machine reaches it.
DOXIE_PAPERLESS_URL=http://paperless.lan:8000

# Paperless -> your name (top right) -> My Profile -> API Auth Token.
DOXIE_PAPERLESS_TOKEN=
